{
  "name": "curerx-desktop",
  "version": "2.5.0",
  "description": "CureRx Pro - Digital Prescription Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [
    "prescription",
    "medical",
    "emr",
    "doctor",
    "clinic"
  ],
  "author": "CureRx HealthTech",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "asar": false,
    "appId": "com.curerx.desktop",
    "productName": "CureRx Pro",
    "directories": {
      "output": "dist_app"
    },
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CureRx Pro"
    }
  }
}
