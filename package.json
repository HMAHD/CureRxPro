{
  "name": "curerx-desktop",
  "version": "2.5.0",
  "description": "CureRx Pro - Digital Prescription Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "lint": "eslint main.js preload.js",
    "prepare-portable": "node scripts/prepare-portable.js",
    "test:js": "bun test tests/js",
    "test:php": "vendor/bin/phpunit",
    "test": "bun run test:php && bun run test:js"
  },
  "keywords": [
    "prescription",
    "medical",
    "emr",
    "doctor",
    "clinic"
  ],
  "author": "CureRx HealthTech",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "6.2.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.0",
    "electron": "30.0.0",
    "electron-builder": "24.13.3",
    "eslint": "8.57.0",
    "happy-dom": "20.14.0"
  },
  "build": {
    "asar": false,
    "appId": "com.curerx.desktop",
    "productName": "CureRx Pro",
    "directories": {
      "output": "dist_app"
    },
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CureRx Pro"
    }
  }
}
