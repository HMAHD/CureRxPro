{
    "name": "curerx/pro",
    "description": "CureRx Pro PHP backend",
    "require": {},
    "require-dev": {
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "CureRx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CureRx\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    }
}
